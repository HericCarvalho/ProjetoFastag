:root {
}

.botao-menu {
    font-size: 29px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgba(255, 255, 255, 0);
    width: 232px;
    height: 80px;
    background-image: url("project://database/Assets/Projeto/Assets/Esther/FAST_TAG_UI_SVG/P%C3%A1gina%20Inicial/PaginaInicial_BotaoComumV1.svg?fileID=7388822144124034973&guid=22cfab10b9b4e7e47bacbe037637b91d&type=3#PaginaInicial_BotaoComumV1");
