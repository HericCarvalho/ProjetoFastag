:root {
}

.tela {
    transition-property: opacity, translate, filter;
    transition-duration: 0.5s, 0.5s, 0.5s;
    transition-timing-function: ease-out, ease-out, ease-out;
}

.tela-saindo {
    opacity: 0;
    translate: 100px 0;
    scale: 1 1;
    filter: blur(10);
}

.tela-entrando {
    opacity: 1;
}
