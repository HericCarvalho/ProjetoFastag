            <ui:Button text="Button" name="power_button3" class="botao_powerup" style="background-image: url(&quot;project://database/Assets/Projeto/Assets/Torres/placeholders/iuyiyuirtert.png?fileID=21300000&amp;guid=eadd3aacf015c994781e24aa5e71631b&amp;type=3#iuyiyuirtert&quot;); top: 46px; right: -133px;"/>
