            <ui:Label text="VITÓRIA! 🤩🤩" name="win_text" style="font-size: 150px; color: rgb(255, 235, 4); -unity-font-definition: url(&quot;project://database/Assets/Projeto/Assets/Torres/fONTS/Super%20Squad.ttf?fileID=12800000&amp;guid=35c9e0ecc3cc98a44916fcba8c099fa1&amp;type=3#Super Squad&quot;); text-overflow: clip; -unity-text-align: middle-center; -unity-font-style: normal; display: none;"/>
