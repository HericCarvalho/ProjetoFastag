<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Painel_Principal" style="flex-grow: 1; background-color: rgba(130, 130, 130, 0.29);">
        <ui:Label text="Fastag" name="Name" style="width: 400px; height: 150px; position: absolute; top: 134px; left: 702px; -unity-text-align: upper-center; -unity-font-style: bold; font-size: 100px; align-items: center; justify-content: center; align-self: center; align-content: center;"/>
        <ui:VisualElement name="Painel_Entrar" style="flex-grow: 1; background-color: rgba(149, 149, 149, 0); display: flex;">
            <ui:Button text="Entrar como Host" name="Host" style="-unity-text-align: middle-center; white-space: pre; font-size: 26px; -unity-font-style: bold; position: absolute; left: 770px; top: 340px; background-color: rgb(0, 165, 100); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); right: auto; bottom: auto;"/>
            <ui:Button text="Entrar como Client" name="Client" style="-unity-text-align: middle-center; white-space: pre; font-size: 26px; -unity-font-style: bold; position: absolute; top: 420px; left: 765px; background-color: rgb(0, 165, 100); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0);"/>
            <ui:Button text="Entrar como Servidor" name="Servidor" style="-unity-text-align: middle-center; white-space: pre; font-size: 26px; -unity-font-style: bold; position: absolute; top: 500px; left: 750px; background-color: rgb(0, 165, 100); border-bottom-left-radius: 10px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px;"/>
            <ui:Button text="X" name="Exit" emoji-fallback-support="true" double-click-selects-word="false" triple-click-selects-line="false" display-tooltip-when-elided="true" enabled="true" style="bottom: 0; right: 0; top: auto; left: auto; position: absolute; font-size: 60px; -unity-text-outline-color: rgb(255, 0, 0); -unity-text-outline-width: 1px; background-color: rgba(255, 255, 255, 0); -unity-text-auto-size: none; -unity-background-image-tint-color: rgba(255, 255, 255, 0); -unity-slice-scale: 0; -unity-slice-type: sliced; display: flex; visibility: visible; overflow: visible; opacity: 1; flex-basis: auto; flex-direction: column; align-items: auto; align-content: auto; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="Painel_Port-IP" enabled="true" picking-mode="Position" style="flex-grow: 1; display: none; visibility: visible; justify-content: center; align-items: auto; flex-direction: column-reverse; overflow: visible;">
        <ui:TextField label="IP" placeholder-text="filler text" name="IP" style="left: 680px; top: 350px; bottom: auto; right: 800px; width: 400px; align-items: center; justify-content: center; align-self: stretch; position: absolute; font-size: 22px; -unity-text-align: middle-center; -unity-font-style: bold;"/>
        <ui:TextField label="Port" placeholder-text="filler text" name="Port" style="top: 400px; left: 680px; right: 800px; bottom: auto; width: 400px; height: auto; position: absolute; font-size: 22px; -unity-font-style: bold; -unity-text-align: middle-center;"/>
        <ui:Button text="Voltar" name="Voltar" style="position: absolute; top: auto; left: auto; bottom: 0; right: 0;"/>
    </ui:VisualElement>
</ui:UXML>
